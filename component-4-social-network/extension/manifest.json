{
  "manifest_version": 3,
  "name": "SNA Moderation (Research Prototype)",
  "version": "0.2.0",
  "description": "Captures public Facebook comment threads and builds an interaction graph for hate-speech moderation research.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.facebook.com/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
